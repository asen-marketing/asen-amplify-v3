{
  "name": "amplifylite",
  "version": "1.0.0",
  "description": "Asen's Amplify Lite theme",
  "scripts": {
    "sass": "sass /scss/index.scss:/css/index.css",
    "sass:watch": "sass --watch /scss/index.scss:/css/index.css",
    "prefix": "postcss /css/index.css --use autoprefixer -o /css/index.css",
    "build": "sass /scss/index.scss:/css/index.css --style=compressed"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.2"
  }
}
