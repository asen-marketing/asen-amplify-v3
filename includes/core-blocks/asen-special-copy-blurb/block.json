{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-special-copy-blurb",
  "title": "Asen - Special Copy Blurb",
  "description": "Statement copy with an optional icon and CTA links.",
  "category": "asen-blocks",
  "icon": "editor-paragraph",
  "keywords": [
    "blurb",
    "statement",
    "copy",
    "icon"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/asen-special-copy-blurb.php"
  },
  "attributes": {
    "style": {
      "type": "object",
      "default": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|lg",
            "bottom": "var:preset|spacing|lg"
          }
        }
      }
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "icon": "<i class=\"fa-regular fa-star\"></i>",
        "blurb": "A short statement that deserves its own moment on the page.",
        "__container_width": "lg",
        "__font_size": "xl"
      }
    }
  }
}
