{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-icon-grid",
  "title": "Asen - Icon Grid",
  "description": "A grid of icons with optional captions and links.",
  "category": "asen-blocks",
  "icon": "grid-view",
  "keywords": [
    "icon",
    "grid",
    "cta",
    "logos"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/core-blocks/asen-icon-grid.php"
  },
  "attributes": {
    "style": {
      "type": "object",
      "default": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|lg",
            "bottom": "var:preset|spacing|lg"
          }
        }
      }
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    }
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "items": [
          {
            "text": "First"
          },
          {
            "text": "Second"
          },
          {
            "text": "Third"
          }
        ],
        "__container_width": "xxl"
      }
    }
  }
}
