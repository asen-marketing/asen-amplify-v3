{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-team-hub",
  "title": "Asen - Team Hub",
  "description": "Team members as a grid or carousel.",
  "category": "asen-blocks",
  "icon": "admin-users",
  "keywords": [
    "team",
    "staff",
    "people",
    "carousel"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/asen-team-hub.php"
  },
  "attributes": {
    "style": {
      "type": "object",
      "default": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|lg",
            "bottom": "var:preset|spacing|lg"
          }
        }
      }
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "number_of_columns": 3,
        "__container_width": "xl",
        "__heading_size": "h6"
      }
    }
  }
}
