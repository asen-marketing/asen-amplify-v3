{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-video-popup",
  "title": "Asen - Video Popup",
  "description": "Image or looping-video teaser that opens a YouTube or uploaded video in a dialog.",
  "category": "asen-blocks",
  "icon": "video-alt3",
  "keywords": [
    "video",
    "popup",
    "modal",
    "youtube"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/asen-video-popup.php"
  },
  "attributes": {
    "style": {
      "type": "object",
      "default": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|lg",
            "bottom": "var:preset|spacing|lg"
          }
        }
      }
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "viewScript": "file:./view.js",
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "teaser_options": "image",
        "hosting_options": "youtube",
        "youtube_video_id": "dQw4w9WgXcQ",
        "__container_width": "xl"
      }
    }
  }
}
