{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-dropdown-links",
  "title": "Asen - Dropdown Links",
  "description": "A list of links behind a dropdown button.",
  "category": "asen-blocks",
  "icon": "arrow-down-alt2",
  "keywords": [
    "dropdown",
    "links",
    "select",
    "menu"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/asen-dropdown-links.php"
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "viewScript": "file:./view.js",
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "default_display_option": "Choose a location",
        "__container_width": "sm"
      }
    }
  }
}
