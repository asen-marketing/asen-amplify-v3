{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/asen-testimonials",
  "title": "Asen - Testimonials",
  "description": "Testimonials as a masonry grid or a carousel (one at a time crossfades).",
  "category": "asen-blocks",
  "icon": "star-filled",
  "keywords": [
    "testimonials",
    "reviews",
    "quotes",
    "carousel"
  ],
  "acf": {
    "mode": "auto",
    "renderTemplate": "/templates/block/core-blocks/asen-testimonials.php"
  },
  "attributes": {
    "style": {
      "type": "object",
      "default": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|lg",
            "bottom": "var:preset|spacing|lg"
          }
        }
      }
    }
  },
  "supports": {
    "align": false,
    "anchor": true,
    "spacing": {
      "padding": [
        "top",
        "bottom"
      ],
      "margin": [
        "top",
        "bottom"
      ]
    },
    "color": {
      "background": true,
      "text": true,
      "link": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "use_carousel": 1,
        "number_of_columns": 1,
        "nav_options": "both",
        "__container_width": "lg",
        "__font_size": "md"
      }
    }
  }
}
